UserInputService.InputBegan:Connect(function(
	input,
	processed
)

	if processed then
		return
	end

	-- Open / close UI
	if input.KeyCode == Settings.UIKey then

		Main.Visible = not Main.Visible

		return
	end

	-- Aim key
	if input.UserInputType == Settings.AimKey then

		aiming = true

		if Settings.Enabled then

			if not currentTarget then
				currentTarget = getTarget()
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType == Settings.AimKey then

		aiming = false

		if not Settings.TargetLock then
			currentTarget = nil
		end
	end
end)

--====================================================
-- MAIN LOOP
--====================================================

local targetCheckTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

	--===============================================
	-- FOV CIRCLE
	--===============================================

	local mousePosition =
		UserInputService:GetMouseLocation()

	FOVCircle.Position =
		UDim2.fromOffset(
			mousePosition.X,
			mousePosition.Y
		)

	FOVCircle.Size =
		UDim2.fromOffset(
			Settings.FOV * 2,
			Settings.FOV * 2
		)

	FOVCircle.Visible =
		Settings.Enabled

	--===============================================
	-- AIM SYSTEM
	--===============================================

	if not Settings.Enabled then

		currentTarget = nil

		return
	end

	if not aiming then
		return
	end

	targetCheckTimer += deltaTime

	-- Re-check target every 0.1 seconds
	if targetCheckTimer >= 0.1 then

		targetCheckTimer = 0

		local validTarget = false

		if currentTarget then

			local character, root, head =
				getCharacter(currentTarget)

			if character then

				local screenPosition, onScreen =
					Camera:WorldToScreenPoint(
						head.Position
					)

				if onScreen then

					local targetPosition =
						Vector2.new(
							screenPosition.X,
							screenPosition.Y
						)

					local mousePos =
						UserInputService:GetMouseLocation()

					local distance =
						(targetPosition - mousePos).Magnitude

					-- Target must remain inside
					-- the actual aim radius
					if distance <= Settings.FOV then

						if isVisible(
							character,
							head.Position
						) then

							validTarget = true
						end
					end
				end
			end
		end

		--===========================================
		-- TARGET SWITCHING
		--===========================================

		if not validTarget then

			if Settings.SwitchTargets or not currentTarget then

				currentTarget = getTarget()

			else

				currentTarget = nil
			end
		end
	end

	--===============================================
	-- AIM AT CURRENT TARGET
	--===============================================

	if currentTarget then
		aimAt(currentTarget)
	end
end)
